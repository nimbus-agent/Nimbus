{
  "name": "nimbus",
  "version": "0.4.0",
  "private": true,
  "overrides": {
    "sharp": "0.34.5",
    "protobufjs": "7.5.8",
    "fast-uri": "3.1.2",
    "vite": "7.3.3",
    "devalue": "5.8.1"
  },
  "workspaces": [
    "packages/gateway",
    "packages/cli",
    "packages/ui",
    "packages/sdk",
    "packages/client",
    "packages/docs",
    "packages/mcp-connectors/onedrive",
    "packages/mcp-connectors/outlook",
    "packages/mcp-connectors/google-photos",
    "packages/mcp-connectors/google-drive",
    "packages/mcp-connectors/gmail",
    "packages/mcp-connectors/github",
    "packages/mcp-connectors/gitlab",
    "packages/mcp-connectors/bitbucket",
    "packages/mcp-connectors/slack",
    "packages/mcp-connectors/teams",
    "packages/mcp-connectors/linear",
    "packages/mcp-connectors/jira",
    "packages/mcp-connectors/notion",
    "packages/mcp-connectors/confluence",
    "packages/mcp-connectors/discord",
    "packages/mcp-connectors/jenkins",
    "packages/mcp-connectors/github-actions",
    "packages/mcp-connectors/circleci",
    "packages/mcp-connectors/pagerduty",
    "packages/mcp-connectors/kubernetes",
    "packages/mcp-connectors/aws",
    "packages/mcp-connectors/azure",
    "packages/mcp-connectors/gcp",
    "packages/mcp-connectors/iac",
    "packages/mcp-connectors/grafana",
    "packages/mcp-connectors/sentry",
    "packages/mcp-connectors/newrelic",
    "packages/mcp-connectors/datadog",
    "packages/mcp-connectors/obsidian",
    "packages/mcp-connectors/snyk",
    "packages/mcp-connectors/bitrise",
    "packages/mcp-connectors/sonarqube",
    "packages/mcp-connectors/semgrep",
    "packages/mcp-connectors/wiz",
    "packages/mcp-connectors/launchdarkly",
    "packages/mcp-connectors/flagsmith",
    "packages/vscode-extension"
  ],
  "scripts": {
    "dev": "bun run --filter './packages/gateway' dev & bun run --filter './packages/cli' dev",
    "build": "bun run --filter '*' build",
    "build:debug": "bun scripts/build-debug.ts",
    "build:release": "bun scripts/build-release.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "audit:high": "bun audit --audit-level high",
    "check-package": "bun scripts/check-package.ts",
    "dev-doctor": "bun scripts/dev-doctor.ts",
    "clean-deep": "bun scripts/clean-deep.ts",
    "audit:structure": "bun scripts/structure-audit/audit-structure.ts",
    "audit:boundaries": "bunx dependency-cruiser --config .dependency-cruiser.cjs --no-progress packages",
    "audit:coverage-floor": "bun scripts/coverage-floor/check.ts",
    "audit:coverage-floor:build-lcov": "bash scripts/coverage-floor/build-lcov.sh",
    "audit:coverage-floor:update-baseline": "bun scripts/coverage-floor/check.ts --update-baseline",
    "audit:dead-code": "bunx knip",
    "audit:duplication": "bunx jscpd packages",
    "audit:exclusion-parity": "bun scripts/coverage-floor/check-exclusion-parity.ts",
    "audit:any": "bun scripts/structure-audit/count-any-usage.ts",
    "audit:invariants": "bun scripts/structure-audit/check-nimbus-invariants.ts --binary-only",
    "audit:doc-refs": "bun scripts/structure-audit/check-doc-references.ts --check",
    "audit:openapi-drift": "bun scripts/structure-audit/check-openapi-drift.ts --check",
    "audit:release-please": "bun scripts/structure-audit/check-release-please-manifest.ts",
    "audit:js-licenses": "bun scripts/structure-audit/check-js-licenses.ts --check",
    "audit:svg-assets": "bun scripts/audit/svg-assets.ts",
    "audit:readme-cli": "bun scripts/audit/readme-cli-commands.ts",
    "audit:package-readmes": "bun scripts/audit/package-readmes.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:markdown": "markdownlint-cli2",
    "format": "biome format --write .",
    "test": "bun test packages/gateway packages/cli packages/sdk packages/client packages/mcp-connectors scripts",
    "test:ci": "bun scripts/run-tests.ts",
    "test:scripts": "bun test scripts",
    "kill-gateway": "bun scripts/kill-gateway.ts",
    "test:unit": "bun test packages/gateway/src packages/cli/src packages/sdk/src",
    "test:integration": "bun test packages/gateway/test/integration/ packages/cli/test/integration/",
    "test:e2e:cli": "bun test packages/cli/test/e2e/",
    "test:e2e:gateway": "bun test packages/gateway/test/e2e/",
    "test:coverage": "bun test packages/gateway packages/cli packages/sdk --coverage",
    "test:coverage:agents": "bun test packages/gateway/src/agents --coverage --coverage-threshold-lines=80",
    "test:coverage:engine": "bun test packages/gateway/src/engine --coverage --coverage-threshold-lines=85",
    "test:coverage:vault": "bun test packages/gateway/src/vault --coverage --coverage-threshold-lines=90",
    "test:coverage:sync": "bun test packages/gateway/src/sync/scheduler.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:rate-limiter": "bun test packages/gateway/src/sync/rate-limiter.test.ts --coverage --coverage-threshold-lines=85",
    "test:coverage:people": "bun test packages/gateway/src/people --coverage --coverage-threshold-lines=80",
    "test:coverage:embedding": "bun test packages/gateway/src/embedding --coverage --coverage-threshold-lines=80",
    "test:coverage:workflow": "bun test packages/gateway/src/automation/workflow-store.test.ts packages/gateway/src/automation/workflow-runner.test.ts packages/gateway/src/automation/workflow-runner-execution.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:watcher": "bun test packages/gateway/src/automation/watcher-store.test.ts packages/gateway/src/automation/watcher-engine.test.ts packages/gateway/src/automation/graph-predicate.test.ts packages/gateway/src/watcher/anomaly-detector.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:extensions": "bun test packages/gateway/src/extensions/auto-update.test.ts packages/gateway/src/extensions/auto-update-apply.test.ts packages/gateway/src/extensions/auto-update-cache.test.ts packages/gateway/src/extensions/auto-update-orchestrate.test.ts packages/gateway/src/extensions/auto-update-permissions-diff.test.ts packages/gateway/src/extensions/auto-update-rpc.test.ts packages/gateway/src/extensions/auto-update-types.test.ts packages/gateway/src/extensions/canonical-json.test.ts packages/gateway/src/extensions/dependency-errors.test.ts packages/gateway/src/extensions/dependency-graph.test.ts packages/gateway/src/extensions/dependency-store.test.ts packages/gateway/src/extensions/dependency-types.test.ts packages/gateway/src/extensions/hard-disable.test.ts packages/gateway/src/extensions/install-from-local.test.ts packages/gateway/src/extensions/manifest.test.ts packages/gateway/src/extensions/missing-dependency-registry.test.ts packages/gateway/src/extensions/publisher-keys.test.ts packages/gateway/src/extensions/registry-client.test.ts packages/gateway/src/extensions/registry-fetcher.test.ts packages/gateway/src/extensions/spawn-env.test.ts packages/gateway/src/extensions/sync.test.ts packages/gateway/src/extensions/verify-extensions.test.ts packages/gateway/src/extensions/verify-signature.test.ts packages/gateway/src/automation/extension-store.test.ts --coverage --coverage-threshold-lines=85",
    "test:coverage:sandbox": "bun test packages/gateway/src/platform/sandbox --coverage --coverage-threshold-lines=80",
    "test:coverage:security": "bun test packages/gateway/src/security/ packages/gateway/src/ipc/security-rpc.test.ts packages/gateway/test/e2e/scenarios/security-scan.e2e.test.ts --coverage --coverage-threshold-lines=80",
    "build:sandbox-helper": "make -C packages/gateway/src-native/sandbox-helper",
    "test:coverage:config": "bun test packages/gateway/src/config --coverage --coverage-threshold-lines=80",
    "test:coverage:client": "bun test packages/client --coverage --coverage-threshold-lines=80",
    "test:coverage:telemetry": "bun test packages/gateway/src/config/telemetry-toml.test.ts packages/gateway/test/unit/telemetry --coverage --coverage-threshold-lines=85",
    "test:coverage:db": "bun test packages/gateway/test/unit/db --coverage --coverage-threshold-lines=85",
    "test:coverage:deployment": "bun test packages/gateway/test/unit/deployment/ packages/gateway/test/integration/deployment/ packages/gateway/test/unit/ipc/deployment-rpc.test.ts packages/gateway/test/unit/ipc/http-auth.test.ts packages/gateway/test/unit/ipc/http-rate-limit.test.ts packages/gateway/test/integration/http/deployments-post-route.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:health": "bun test packages/gateway/test/unit/connectors/health.test.ts --coverage --coverage-threshold-lines=85",
    "test:coverage:metrics": "bun test packages/gateway/test/unit/metrics/ packages/gateway/test/integration/metrics/ packages/gateway/test/unit/ipc/metrics-rpc.test.ts packages/gateway/test/integration/http/metrics-dora-route.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:preflight": "bun test packages/gateway/test/unit/preflight/ packages/gateway/test/integration/preflight/ packages/gateway/test/unit/ipc/preflight-rpc.test.ts packages/gateway/test/integration/http/preflight-deploy-route.test.ts packages/gateway/test/unit/connectors/github-sync-mergeable.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:doctor": "bun test packages/cli/src/commands/doctor*.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:mcp": "bun test packages/mcp-connectors --coverage --coverage-threshold-lines=70",
    "test:coverage:tui": "bun test packages/cli/src/tui/ --coverage --coverage-threshold-lines=80",
    "test:coverage:updater": "bun test packages/gateway/src/updater packages/gateway/src/ipc/updater-rpc.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:lan": "bun test packages/gateway/src/ipc/lan-crypto.test.ts packages/gateway/src/ipc/lan-pairing.test.ts packages/gateway/src/ipc/lan-rate-limit.test.ts packages/gateway/src/ipc/lan-rpc.test.ts packages/gateway/src/ipc/lan-server.test.ts packages/gateway/test/integration/lan/ --coverage --coverage-threshold-lines=80",
    "test:coverage:perf": "bun test packages/gateway/src/perf packages/cli/src/commands/bench.test.ts --coverage --coverage-threshold-lines=80",
    "test:coverage:sdk": "bun test packages/sdk --coverage --coverage-threshold-lines=80",
    "test:coverage:vscode-extension": "cd packages/vscode-extension && bunx vitest run --coverage",
    "record-casts": "bun scripts/cast-driver/run.ts",
    "render:og-card": "bun scripts/render-og-card.ts",
    "render:hero-cast": "bun scripts/render-hero-cast.ts",
    "regen-slo": "bun scripts/regen-slo.ts",
    "regen-slo:check": "bun scripts/regen-slo.ts --check",
    "docs:build": "bun run --filter @nimbus/docs build",
    "package:headless": "bun scripts/package-headless-bundle.ts",
    "package:installers:linux": "bun scripts/package-linux-installers.ts",
    "clean": "bun run --filter '*' clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^17.4.0",
    "js-yaml": "^4.1.1",
    "jscpd": "^4.2.3",
    "knip": "^6.13.1",
    "markdownlint-cli2": "^0.22.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
