    "test:coverage:mcp": "bun test packages/mcp-connectors --coverage --coverage-threshold-lines=70 --timeout 30000",
    "test:coverage:tui": "bun test packages/cli/src/tui/ --coverage --coverage-threshold-lines=80 --timeout 30000",
    "test:coverage:updater": "bun test packages/gateway/src/updater packages/gateway/src/ipc/updater-rpc.test.ts --coverage --coverage-threshold-lines=80 --timeout 30000",
