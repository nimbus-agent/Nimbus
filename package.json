    "render:hero-cast": "bun scripts/render-hero-cast.ts",
    "regen-slo": "bun scripts/regen-slo.ts",
    "regen-slo:check": "bun scripts/regen-slo.ts --check",
    "docs:build": "bun run --filter @nimbus/docs build",
    "package:headless": "bun scripts/package-headless-bundle.ts",
    "package:installers:linux": "bun scripts/package-linux-installers.ts",
    "release:verify-assets": "bun scripts/release/verify-release-assets.ts",
    "release:secret-health": "bun scripts/release/check-secret-health.ts",
    "clean": "bun run --filter '*' clean && rm -rf node_modules"
