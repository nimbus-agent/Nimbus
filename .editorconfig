# EditorConfig — https://editorconfig.org
# Biome handles formatting; EditorConfig sets baseline editor behavior.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.rs]
indent_size = 4

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.{cmd,ps1}]
end_of_line = crlf
