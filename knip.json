{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "packages/github-actions/*/src/main.ts"],
      "ignore": ["**/*.test.ts", "packages/github-actions/*/dist/**"]
    },
    "packages/gateway": {
      "entry": [
        "src/index.ts",
        "src/db/query-guard-worker.ts",
        "src/embedding/embedding-worker.ts",
        "src/perf/surfaces/sqlite-worker-sync.ts",
        "src/perf/surfaces/sqlite-worker-watcher.ts",
        "src/perf/surfaces/sqlite-worker-audit.ts",
        "src/**/*.test.ts",
        "test/**/*.test.ts"
      ],
      "project": "src/**/*.ts"
    },
    "packages/cli": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/ui": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}"
    }
  },
  "ignoreDependencies": ["markdownlint-cli2", "@stryker-mutator/command-runner"],
  "ignoreBinaries": ["gitleaks", "make", "pwsh", "termsvg"]
}
