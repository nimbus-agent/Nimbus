---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CatalogNav from "../../components/catalog/CatalogNav.astro";
import ExtensionList from "../../components/catalog/ExtensionList.astro";
import raw from "../../data/official-registry.json";
import { filterCatalog, parseCatalog } from "../../lib/catalog";

const catalog = parseCatalog(raw);
---

<StarlightPage frontmatter={{ title: "Extensions from verified publishers" }}>
  <CatalogNav catalog={catalog} />
  <ExtensionList extensions={filterCatalog(catalog, { verified: true })} />
</StarlightPage>
