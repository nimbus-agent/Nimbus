{
  "name": "@nimbus/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run compile-gateway.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist",
    "test:coverage:updater": "bun test --coverage src/updater",
    "test:coverage:lan": "bun test --coverage src/ipc/lan-crypto.test.ts src/ipc/lan-pairing.test.ts src/ipc/lan-rate-limit.test.ts src/ipc/lan-rpc.test.ts src/ipc/lan-server.test.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.43.0",
    "@mastra/mcp": "^1.10.0",
    "@nimbus-dev/sdk": "^1.6.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@xenova/transformers": "^2.17.0",
    "bonjour-service": "^1.4.1",
    "bs58": "^6.0.0",
    "hyparquet": "^1.26.0",
    "imapflow": "^1.3.5",
    "js-yaml": "^5.2.2",
    "pino": "^10.3.1",
    "semver": "^7.8.3",
    "sqlite-vec": "^0.1.6",
    "tar": "^7.5.20",
    "tsdav": "^2.2.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/pidusage": "^2.0.5",
    "@types/semver": "^7.7.1",
    "@types/tar": "^7.0.87",
    "fast-check": "^4.8.0",
    "msw": "^2.14.6",
    "pidusage": "^4.0.1"
  }
}
