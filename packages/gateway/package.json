{
  "name": "@nimbus/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run compile-gateway.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist",
    "test:coverage:updater": "bun test --coverage src/updater",
    "test:coverage:lan": "bun test --coverage src/ipc/lan-crypto.test.ts src/ipc/lan-pairing.test.ts src/ipc/lan-rate-limit.test.ts src/ipc/lan-rpc.test.ts src/ipc/lan-server.test.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.74.0",
    "@mastra/mcp": "^2.1.2",
    "@nimbus-dev/connectors": "^0.2.4",
    "@nimbus-dev/sdk": "^2.0.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@xenova/transformers": "^2.17.0",
    "bonjour-service": "^1.4.4",
    "bs58": "^6.0.0",
    "hyparquet": "^1.31.2",
    "imapflow": "^2.2.5",
    "js-yaml": "^5.4.2",
    "pino": "^10.4.0",
    "semver": "^7.8.3",
    "sqlite-vec": "^0.1.6",
    "tar": "^7.5.22",
    "tsdav": "^2.3.5",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pidusage": "^2.0.5",
    "@types/semver": "^7.8.0",
    "fast-check": "^4.10.2",
    "msw": "^2.15.0",
    "pidusage": "^4.0.1"
  }
}
