{
  "id": "com.nimbus.slack",
  "displayName": "Slack",
  "version": "0.1.0",
  "description": "Slack connector (channels, messages, search). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["slack.com", "api.slack.com", "wss-primary.slack.com", "wss-backup.slack.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 60,
  "minNimbusVersion": "0.2.0"
}
