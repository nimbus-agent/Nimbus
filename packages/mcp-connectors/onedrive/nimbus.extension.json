{
  "id": "com.nimbus.onedrive",
  "displayName": "OneDrive",
  "version": "0.1.0",
  "description": "Microsoft Graph OneDrive connector (drive items, search, sharing). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["graph.microsoft.com", "login.microsoftonline.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
