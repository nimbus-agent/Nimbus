{
  "id": "com.nimbus.google-photos",
  "displayName": "Google Photos",
  "version": "0.1.0",
  "description": "Google Photos Library API connector (media items, albums, search). Read-focused.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["www.googleapis.com", "photoslibrary.googleapis.com", "oauth2.googleapis.com"]
  },
  "hitlRequired": [],
  "syncInterval": 600,
  "minNimbusVersion": "0.2.0"
}
