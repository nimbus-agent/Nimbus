{
  "id": "com.nimbus.notion",
  "displayName": "Notion",
  "version": "0.1.0",
  "description": "Notion REST connector (databases, pages, search). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["api.notion.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
