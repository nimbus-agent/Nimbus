{
  "id": "com.nimbus.teams",
  "displayName": "Microsoft Teams",
  "version": "0.1.0",
  "description": "Microsoft Graph Teams connector (teams, channels, messages). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": [
      "graph.microsoft.com",
      "login.microsoftonline.com",
      "smba.trafficmanager.net",
      "api.botframework.com"
    ]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
