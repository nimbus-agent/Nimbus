{
  "id": "com.nimbus.outlook",
  "displayName": "Outlook",
  "version": "0.1.0",
  "description": "Microsoft Graph Outlook connector (mail, calendar). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["graph.microsoft.com", "login.microsoftonline.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 120,
  "minNimbusVersion": "0.2.0"
}
