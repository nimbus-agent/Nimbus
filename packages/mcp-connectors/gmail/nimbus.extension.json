{
  "id": "com.nimbus.gmail",
  "displayName": "Gmail",
  "version": "0.1.0",
  "description": "Gmail REST connector (messages, threads, labels, search). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["www.googleapis.com", "gmail.googleapis.com", "oauth2.googleapis.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 120,
  "minNimbusVersion": "0.2.0"
}
