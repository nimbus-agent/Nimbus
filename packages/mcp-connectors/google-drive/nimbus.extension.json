{
  "id": "com.nimbus.google-drive",
  "displayName": "Google Drive",
  "version": "0.1.0",
  "description": "Google Drive v3 connector (files, folders, search). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["www.googleapis.com", "oauth2.googleapis.com", "accounts.google.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
