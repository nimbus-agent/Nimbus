{
  "id": "com.nimbus.circleci",
  "displayName": "CircleCI",
  "version": "0.1.0",
  "description": "CircleCI v2 connector (pipelines, workflows, jobs). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["circleci.com", "api.circleci.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 120,
  "minNimbusVersion": "0.2.0"
}
