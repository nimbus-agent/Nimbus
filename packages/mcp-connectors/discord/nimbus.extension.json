{
  "id": "com.nimbus.discord",
  "displayName": "Discord",
  "version": "0.1.0",
  "description": "Discord opt-in connector (guilds, channels, messages). Disabled by default. Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["discord.com", "gateway.discord.gg", "cdn.discordapp.com"]
  },
  "hitlRequired": [],
  "syncInterval": 120,
  "minNimbusVersion": "0.2.0"
}
