{
  "id": "com.nimbus.aws",
  "displayName": "AWS",
  "version": "0.1.0",
  "description": "AWS CLI connector (region-agnostic control plane). Non-default regions / data-plane hosts are a known Task 14 follow-up. Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": [
      "sts.amazonaws.com",
      "iam.amazonaws.com",
      "s3.amazonaws.com",
      "ec2.amazonaws.com",
      "cloudfront.amazonaws.com"
    ]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 600,
  "minNimbusVersion": "0.2.0"
}
