{
  "id": "com.nimbus.github-actions",
  "displayName": "GitHub Actions",
  "version": "0.1.0",
  "description": "GitHub Actions workflows / runs / artifacts via the GitHub REST API. Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["api.github.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
