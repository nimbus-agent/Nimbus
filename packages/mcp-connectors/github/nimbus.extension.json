{
  "id": "com.nimbus.github",
  "displayName": "GitHub",
  "version": "0.1.0",
  "description": "GitHub REST + GraphQL connector (PRs, issues, reviews, releases). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["api.github.com", "uploads.github.com", "raw.githubusercontent.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
