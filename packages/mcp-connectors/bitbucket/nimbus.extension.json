{
  "id": "com.nimbus.bitbucket",
  "displayName": "Bitbucket Cloud",
  "version": "0.1.0",
  "description": "Bitbucket Cloud REST connector (repositories, pull requests). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["api.bitbucket.org", "bitbucket.org"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 300,
  "minNimbusVersion": "0.2.0"
}
