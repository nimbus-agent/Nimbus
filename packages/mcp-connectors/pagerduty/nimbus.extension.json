{
  "id": "com.nimbus.pagerduty",
  "displayName": "PagerDuty",
  "version": "0.1.0",
  "description": "PagerDuty REST + Events API connector (incidents, services, schedules). Mutations require Gateway HITL.",
  "author": "Nimbus",
  "entrypoint": "dist/server.js",
  "runtime": "bun",
  "permissions": {
    "network": ["api.pagerduty.com", "events.pagerduty.com"]
  },
  "hitlRequired": ["write", "delete"],
  "syncInterval": 60,
  "minNimbusVersion": "0.2.0"
}
