# ============================================================
# Nimbus — .gitignore
# Bun / Node / TypeScript / OS / Tauri / Rust artifacts
# ============================================================

# --- Bun / Node ---
node_modules/
.bun-cache/
*.bun

# --- Build outputs ---
dist/
build/
out/
.astro/

# GitHub Actions bundles MUST be committed — the Actions runtime executes
# dist/index.js directly with no install step (Phase 5 T4 PR 3a).
!packages/github-actions/*/dist/
!packages/github-actions/*/dist/**

# Bundled JS must not live under package src/ (use dist/ or repo root dist/ via scripts/build-debug.ts)
packages/cli/src/nimbus.js
packages/cli/src/nimbus.js.map
packages/gateway/src/nimbus-gateway.js
packages/gateway/src/nimbus-gateway.js.map
packages/mcp-connectors/*/src/nimbus-mcp-*.js
packages/mcp-connectors/*/src/nimbus-mcp-*.js.map

# admin-console build output (static bundle; produced by `bun run build`)
packages/admin-console/dist/

*.vsix
.turbo/

# --- TypeScript ---
*.tsbuildinfo
*.d.ts.map

# --- Coverage / CI test reports ---
coverage/
# scripts/coverage/ holds the istanbul instrumentation source (NOT generated output) —
# the bare `coverage/` glob above would otherwise ignore it. Keep it (and any
# nested files/subdirs, explicitly) tracked.
!scripts/coverage/
!scripts/coverage/**
# JUnit XML for CI lives under junit-reports/ (not ignored — dorny/test-reporter uses fast-glob with gitignore).
reports/
.stryker-tmp/
.nyc_output/
lcov.info
*.lcov

# --- Logs ---
*.log
logs/
pino-*.log

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.cer
nimbus.toml

# --- OS ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --- Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-*

# --- Tauri / Rust ---
src-tauri/target/
src-tauri/WixTools/
*.dmg
*.deb
*.AppImage
*.app/
gen/

# --- Tauri WebView caches ---
.webview2/
WebView2Loader.dll

# --- SQLite (runtime databases) ---
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# --- Test artifacts ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.snap

# --- Git worktrees ---
.worktrees/
.claude/worktrees/

# --- Local, machine-specific dev helpers (not product code; platform-equality N/A) ---
scripts/local/

# --- Superpowers brainstorming artifacts ---
.superpowers/

# --- Release binaries ---
nimbus-*.exe
nimbus-*.dmg
nimbus-*.deb
nimbus-*.AppImage
nimbus

# Per-run audit-orchestrator output (committed artifacts are tracked separately)
docs/structure-audit/run-*.json
# Regenerable audit report dumps — overwritten by audit:structure / audit:invariants on every run.
# (The ratchet baselines coverage-baseline.json / any-baseline.json and the *.md docs stay tracked.)
docs/structure-audit/jscpd-report.json
docs/structure-audit/churn-90d.json
docs/structure-audit/knip-report.json
docs/structure-audit/risky-assertions.json
docs/structure-audit/file-loc.json
docs/structure-audit/db-run-census.json

packages/docs/src/assets/nimbus-wordmark-*.svg
packages/docs/src/assets/architecture-*.svg
.sonar/

# lychee link-check cache (scripts/check-links.sh); successes only, 1h TTL
.lycheecache

# Subagent-driven-development scratch: ledger, task briefs, implementer reports
# and review packages for a plan in flight. Working notes — the commits they
# name are the durable record.
.superpowers/
